# Ollama teacher
CODEMORPH_OLLAMA_HOST=http://localhost:11434
CODEMORPH_TEACHER_MODEL=beam
CODEMORPH_OLLAMA_TIMEOUT=300
CODEMORPH_CANDIDATES=1

# Allowed licenses for acquisition
CODEMORPH_ALLOWED_LICENSES=MIT,Apache-2.0,BSD-2-Clause,BSD-3-Clause

# Paths
CODEMORPH_DATASET_ROOT=datasets
CODEMORPH_OUTPUT_ROOT=outputs
CODEMORPH_MODELS_ROOT=models

# Optional JSON file describing local repositories to acquire
CODEMORPH_SOURCE_CONFIG=

# Optional JSON file containing curated C++ samples
CODEMORPH_SAMPLES=

# Model sizes to prepare
CODEMORPH_MODEL_SIZES=10m,30m,60m,100m